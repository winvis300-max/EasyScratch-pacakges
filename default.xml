<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!-- GitHub -->
    <remote
        name="github"
        fetch="https://github.com/" />

    <!-- GNU Savannah -->
    <remote
        name="savannah"
        fetch="https://git.savannah.gnu.org/git/" />

    <!-- Sourceware -->
    <remote
        name="sourceware"
        fetch="git://sourceware.org/git/" />

    <!-- GoogleSource -->
    <remote
        name="googlesource"
        fetch="https://kernel.googlesource.com/pub/scm/utils/util-linux/" />

    <!-- Varsayılan -->
    <default
        remote="github"
        revision="main" />

    <!-- sudo -->
    <project
        name="sudo-project/sudo"
        path="sudo" />

    <!-- GCC -->
    <project
        name="gcc-mirror/gcc"
        path="gcc"
        revision="master" />

    <!-- shadow -->
    <project
        name="shadow-maint/shadow"
        path="shadow"
        revision="master" />

    <!-- chimerautils -->
    <project
        name="chimera-linux/chimerautils"
        path="chimerautils"
        revision="master" />

    <!-- glibc -->
    <project
        name="glibc.git"
        remote="sourceware"
        path="glibc"
        revision="master" />

    <!-- GNU nano -->
    <project
        name="nano.git"
        remote="savannah"
        path="nano"
        revision="master" />

    <!-- GNU Bash -->
    <project
        name="bash.git"
        remote="savannah"
        path="bash"
        revision="master" />

    <!-- util-linux -->
    <project
        name="util-linux"
        remote="googlesource"
        path="util-linux"
        revision="master" />

    <!-- man-db -->
    <project
        name="man-db.git"
        remote="savannah"
        path="man-db"
        revision="master" />

    <!-- Limine -->
    <project
        name="limine-bootloader/limine"
        path="limine"
        revision="master" />

    <!-- GNU Binutils + GDB -->
    <project
        name="binutils-gdb.git"
        remote="sourceware"
        path="binutils-gdb"
        revision="master" />

    <!-- GMP -->
    <project
        name="gmp"
        remote="savannah"
        path="gmp"
        revision="master" />

    <!-- GNU Make -->
    <project
        name="make.git"
        remote="savannah"
        path="make"
        revision="master" />

    <!-- kmod -->
    <project
        name="kmod-project/kmod"
        path="kmod"
        revision="master" />

    <!-- dracut -->
    <project
        name="dracutdevs/dracut"
        path="dracut"
        revision="master" />

</manifest>

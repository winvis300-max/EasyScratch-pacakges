<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="github"
        fetch="https://github.com/" />

    <remote
        name="sourceware"
        fetch="git://sourceware.org/git/" />

    <remote
        name="savannah"
        fetch="https://git.savannah.gnu.org/git/" />

    <default
        remote="github"
        revision="main" />

    <project
        name="sudo-project/sudo"
        path="sudo" />

    <project
        name="glibc.git"
        remote="sourceware"
        path="glibc"
        revision="master" />

    <project
        name="nano.git"
        remote="savannah"
        path="nano"
        revision="master" />

</manifest>

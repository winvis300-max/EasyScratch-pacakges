<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="github"
        fetch="https://github.com/" />

    <remote
        name="sourceware"
        fetch="git://sourceware.org/git/" />

    <!-- GitHub projeleri için varsayılan -->
    <default
        remote="github"
        revision="main" />

    <!-- sudo -->
    <project
        name="sudo-project/sudo"
        path="sudo"
        revision="main" />

    <!-- glibc -->
    <project
        name="glibc.git"
        remote="sourceware"
        path="glibc"
        revision="master" />

</manifest>
